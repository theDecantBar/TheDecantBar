# Server Configuration
PORT=5000

# Administrator Emails (Comma-separated emails with automatic Admin Hub access)
ADMIN_EMAILS=admin@thedecantbar.com,thedecantbarofficial@gmail.com

# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=thedecantbar
DB_PASSWORD=your_password_here
DB_PORT=5432
DB_URL=postgresql://postgres:password@localhost:5432/thedecantbar
DB_SSL=false

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 / Google Identity Services

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=The Decant Bar <orders@thedecantbar.com>

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Supabase Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
